{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.3.0",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-sonnet-5-5",
  "defaultThinkingLevel": "off",
  "modelThinkingLevels": {
    "lmstduio/ornith-1.5-35b-a3b-reap192-mlx": "off",
    "anthropic/claude-haiku-5-5": "high",
    "anthropic/claude-sonnet-5-5": "high",
    "anthropic/claude-opus-5-5": "medium"
  },
  "packages": [
    {
      "source": "npm:pi-subagents",
      "skills": ["-skills/council-mode/SKILL.md"],
      "prompts": []
    },
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:@juicesharp/rpiv-todo",
    "../../projects/pi-ocz"
  ],
  "hideThinkingBlock": false,
  "showHardwareCursor": true,
  "skills": [
    "-skills/writing-css/SKILL.md",
    "-skills/jira-atlassian-cli/SKILL.md",
    "-skills/multi-provider-web-search/SKILL.md"
  ],
  "theme": "dark",
  "warnings": {
    "anthropicExtraUsage": true
  },
  "enabledModels": [
    "anthropic/claude-sonnet-5-5",
    "anthropic/claude-opus-5-5",
    "anthropic/claude-haiku-5-5"
  ],
  "subagents": {
    "agentOverrides": {
      "worker": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write",
          "contact_supervisor",
          "web_fetch",
          "web_search",
          "subagent"
        ]
      },
      "delegate": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write",
          "contact_supervisor",
          "web_fetch",
          "web_search",
          "subagent"
        ]
      },
      "scout": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write",
          "contact_supervisor",
          "web_fetch",
          "web_search",
          "subagent"
        ]
      },
      "researcher": {
        "disabled": true
      },
      "evidence-auditor": {
        "disabled": true
      },
      "oracle": {
        "disabled": true
      }
    }
  }
}
