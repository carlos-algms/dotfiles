#!/usr/bin/env python3
"""Compare OpenRouter providers for one model: applied prices, p90 latency,
p90 throughput and simulated long-session cost.

Usage: openrouter-providers-comparison [-n COUNT] [-o RATIO] [-c HIT] MODEL

  MODEL        OpenRouter model id, e.g. z-ai/glm-5.3
  -n COUNT     providers to show, ranked by price/speed (default: 5)
  -o RATIO     output tokens as a fraction of input tokens (default: 0.1)
  -c HIT       cache hit rate on input tokens (default: 0.95)

Prices are the applied rates: the page `pricing` block already has
`pricing.discount` subtracted. `pricing_json` is the undiscounted list price.
A missing price counts as 0 (free or promotional endpoint).

Session cost = cache miss + cache read + output:
  input*(1-HIT)*$/M_miss + input*HIT*$/M_cache + input*RATIO*$/M_out
$/M_miss is the cache write price where the provider charges one, else the
input price. Session sizes are total prompt tokens. Prefer p90 latency <= 2s,
ranked by session cost / p90 throughput. Fill remaining slots with slower
providers by latency, then price/speed; unknown metrics rank last.
"""

import argparse
import json
import math
import re
import sys
import urllib.error
import urllib.request

SESSIONS = (100_000, 150_000, 250_000)
MAX_LATENCY_MS = 2000
UA = {"User-Agent": "Mozilla/5.0"}
EP = re.compile(r'\{"id":"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"')


def fetch(url):
    try:
        with urllib.request.urlopen(
            urllib.request.Request(url, headers=UA), timeout=30
        ) as res:
            return res.read().decode()
    except (urllib.error.URLError, TimeoutError) as e:
        raise SystemExit(f"{url}: {e}") from None


def endpoints(model):
    """Per-provider pricing and stats. The page embeds each endpoint as JSON,
    the public endpoints API has no latency or throughput."""
    html = fetch("https://openrouter.ai/" + model).replace('\\"', '"')
    dec, out, skipped = json.JSONDecoder(), {}, 0
    for m in EP.finditer(html):
        try:
            o, _ = dec.raw_decode(html, m.start())
        except ValueError:
            skipped += 1
            continue
        stats = o.get("stats")
        if isinstance(stats, dict) and "p90_latency" in stats:
            out[o["provider_slug"]] = o
    if skipped:
        print(f"warning: {skipped} embedded objects failed to parse", file=sys.stderr)
    return out


def per_m(price, key, default=0.0):
    value = price.get(key)
    return default if value is None else float(value) * 1e6


def row(slug, ep, hit, ratio):
    price = ep.get("pricing") or {}
    inp = per_m(price, "prompt")
    cache = per_m(price, "input_cache_read", inp)
    miss = per_m(price, "input_cache_write", inp)
    out = per_m(price, "completion")
    per_prompt_m = miss * (1 - hit) + cache * hit + out * ratio
    stats = ep["stats"]
    return {
        "slug": slug,
        "quant": ep.get("quantization") or "-",
        "in": inp,
        "cache": cache,
        "out": out,
        "lat": stats.get("p90_latency"),
        "tps": stats.get("p90_throughput"),
        "cost": [s / 1e6 * per_prompt_m for s in SESSIONS],
    }


def status(r):
    lat, tps = r["lat"], r["tps"]
    if (
        lat is None
        or tps is None
        or not math.isfinite(lat)
        or not math.isfinite(tps)
        or lat < 0
        or tps <= 0
    ):
        return "unknown"
    return "ready" if lat <= MAX_LATENCY_MS else "fallback"


def rank_key(r):
    state = status(r)
    if state == "unknown":
        return (2, float("inf"), float("inf"), 0)
    score = r["cost"][-1] / r["tps"]
    if state == "fallback":
        return (1, r["lat"], score, -r["tps"])
    return (0, score, r["lat"], -r["tps"])


def fmt(value, spec):
    return "-" if value is None else format(value, spec)


def main():
    ap = argparse.ArgumentParser(
        usage="%(prog)s [-n COUNT] [-o RATIO] [-c HIT] MODEL",
        description="Per-provider cost, p90 latency and p90 throughput for one "
        "OpenRouter model, ranked for long sessions.",
    )
    ap.add_argument("model")
    ap.add_argument("-n", type=int, default=5, help="providers to show")
    ap.add_argument("-o", type=float, default=0.1, help="output/input ratio")
    ap.add_argument("-c", type=float, default=0.95, help="cache hit rate")
    args = ap.parse_args()
    if not 0 <= args.c <= 1 or not 0 <= args.o < float("inf"):
        ap.error("-c must be within 0..1, -o must be finite and >= 0")
    if args.n < 1:
        ap.error("-n must be >= 1")

    eps = endpoints(args.model)
    if not eps:
        raise SystemExit(f"no endpoints found for {args.model}")

    rows = sorted(
        (row(s, e, args.c, args.o) for s, e in eps.items()),
        key=rank_key,
    )[: args.n]

    head = (
        f"{'provider':<28}{'quant':<9}{'$/M in':>8}{'$/M cache':>11}"
        f"{'$/M out':>9}{'p90 ms':>8}{'p90 t/s':>9}"
        + "".join(f"{s // 1000}k".rjust(9) for s in SESSIONS)
        + f"  {'status':<8}"
    )
    print(f"{args.model}  cache={args.c:.0%}  out={args.o:.0%} of input")
    print(head)
    print("-" * len(head))
    for r in rows:
        print(
            f"{r['slug']:<28}{r['quant']:<9}{r['in']:>8.3f}{r['cache']:>11.3f}"
            f"{r['out']:>9.3f}{fmt(r['lat'], '.0f'):>8}{fmt(r['tps'], '.0f'):>9}"
            + "".join(f"${c:.3f}".rjust(9) for c in r["cost"])
            + f"  {status(r):<8}"
        )


if __name__ == "__main__":
    main()
