#!/usr/bin/env bash

set -euo pipefail

# ==============================================================================
# llm-models — List model IDs from public model APIs (no auth needed)
#
# Usage: llm-models [-h|--help] [-a] [-f REGEX] [provider ...]
#   providers: zen openrouter nous (default: all)
#   default    keep only models priced at zero on both input and output
#   -a         keep every model, priced or not
#   -f REGEX   also keep only IDs matching REGEX, case-insensitive
#   -h, --help show this help
#
# Output: "<provider> <id>" with aligned columns, sorted.
# ==============================================================================

readonly URL_ZEN="https://opencode.ai/zen/v1/models"
readonly URL_OPENROUTER="https://openrouter.ai/api/v1/models"
readonly URL_NOUS="https://inference-api.nousresearch.com/v1/models"

usage() {
    sed -n '/^# Usage/,/^# Output/p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit "${1:-1}"
}

list_models() {
    local provider="$1" url="$2"
    # Zen prices live in cost.text, the OpenRouter-compatible APIs in pricing.
    # A missing price maps to -1 so it never counts as free.
    curl -fsS -m 30 "$url" |
        jq -r --arg p "$provider" --argjson all "$all" '
            .data[]
            | {id, i: (.cost.text.input.price // .pricing.prompt),
                 o: (.cost.text.output.price // .pricing.completion)}
            | select($all or ((.i | tonumber? // -1) == 0 and
                              (.o | tonumber? // -1) == 0))
            | "\($p)\t\(.id)"'
}

all=false
filter=
[ "${1:-}" = "--help" ] && usage 0
while getopts "af:h" opt; do
    case "$opt" in
        a) all=true ;;
        f) filter="$OPTARG" ;;
        h) usage 0 ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))

providers=("$@")
[ ${#providers[@]} -eq 0 ] && providers=(zen openrouter nous)

for p in "${providers[@]}"; do
    case "$p" in
        zen) url="$URL_ZEN" ;;
        openrouter) url="$URL_OPENROUTER" ;;
        nous) url="$URL_NOUS" ;;
        *)
            echo "unknown provider: $p" >&2
            usage
            ;;
    esac
    list_models "$p" "$url"
done | sort -u | column -t -s "$(printf '\t')" | { rg -i -- "$filter" || true; }
